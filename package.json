{
  "name": "la-comfianza-payroll",
  "version": "0.1.0",
  "private": true,
  "description": "La Comfianza Multi-Company Payroll System",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",

    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",

    "generate": "pnpm --filter @payroll/database generate",
    "db:validate": "pnpm --filter @payroll/database validate",

    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",

    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:validate"
  }
}
